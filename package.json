{
  "name": "v-link",
  "version": "1.0.0",
  "description": "V-Link Media Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.vini.vlink",
    "productName": "V-Link",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  }
}